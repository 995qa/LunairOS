# LunairOS BusyBox minimal config

# Binário estático
CONFIG_STATIC=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_STANDALONE=y

# Shell
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_BUILTIN_PRINTF=y
CONFIG_ASH_BUILTIN_TEST=y

# Init/TTY
CONFIG_CTTYHACK=y
CONFIG_SETSID=y

# Coreutils básicas
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_ECHO=y
CONFIG_FALSE=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MKNOD=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_SYNC=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TEST2=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_UNAME=y

# Sistema
CONFIG_CLEAR=y
CONFIG_DMESG=y
CONFIG_HOSTNAME=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_REBOOT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y

# Processos/debug básico
CONFIG_KILL=y
CONFIG_PS=y

# Texto/debug
CONFIG_GREP=y
CONFIG_SED=y

# /dev automático opcional
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_EXEC=y

# Módulos do kernel
CONFIG_INSMOD=y
CONFIG_LSMOD=y
CONFIG_RMMOD=y
CONFIG_MODPROBE=y
CONFIG_DEPMOD=y

# Para futuramente trocar initramfs por rootfs real
CONFIG_SWITCH_ROOT=y
